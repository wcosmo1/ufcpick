# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ufc_cornerman?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# AI providers
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# Inngest
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY=""

# Events data source
# USE_MOCK_EVENTS=true  — force mock events/fights (skip ESPN)
# Default: fetch live upcoming UFC events from ESPN public scoreboard APIs,
# with in-memory cache (~10 min) and automatic mock fallback on failure.
# USE_MOCK_EVENTS=true
